{
    "compilerOptions":  {
                            "skipLibCheck":  true,
                            "module":  "commonjs",
                            "declaration":  true,
                            "outDir":  "./dist",
                            "strict":  true,
                            "esModuleInterop":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "target":  "es2020"
                        },
    "include":  [
                    "src/**/*"
                ]
}
